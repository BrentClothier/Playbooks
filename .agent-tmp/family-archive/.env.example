# Family Archive stack environment variables for Portainer
# Copy these into Portainer stack environment variables.
# Do not commit real secrets to Git.

TZ=America/Los_Angeles

# NFS server and remote family archive root
NFS_SERVER=192.168.86.82
NFS_EXPORT_ROOT=/data/apps/family-archive

# Immich
IMMICH_HTTP_PORT=2283
IMMICH_VERSION=v3
IMMICH_DB_STORAGE_TYPE=SSD
IMMICH_DB_USERNAME=postgres
IMMICH_DB_NAME=immich
# Generate with: opens