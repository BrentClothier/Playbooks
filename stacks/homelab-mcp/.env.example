# HomeLab MCP stack environment variables for Portainer
# Copy these into Portainer stack environment variables.
# Do not commit real secrets to Git.

# Proxmox base URL; do not include /api2/json.
PVE_URL=https://proxmox.example.internal:8006
PVE_TOKEN_ID=mcp-reader@pve!chatgpt
PVE_TOKEN_SECRET=change-me
PVE_VERIFY_SSL=true

# Semaphore UI API.
# Use an address reachable from the homelab-mcp container.
SEMAPHORE_URL=http://semaphore.example.internal:3000
SEMAPHORE_API_TOKEN=change-me
SEMAPHORE_VERIFY_SSL=true

# Which Semaphore templates can be started through ChatGPT.
# Use "*" to allow all current and future templates.
# Or use comma-separated project_id:template_id pairs for a restricted list.
SEMAPHORE_ALLOWED_TEMPLATES=*

# Loopback-only local test port for the MCP server.
MCP_HTTP_PORT=8765

# OpenAI Secure MCP Tunnel.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me
CONTROL_PLANE_API_KEY=sk-replace-me

# Loopback-only tunnel-client admin/health UI.
TUNNEL_HTTP_PORT=8766
