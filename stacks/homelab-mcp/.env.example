# HomeLab MCP stack environment variables for Portainer
# Copy these into Portainer stack environment variables.
# Do not commit real secrets to Git.

# Proxmox base URL; do not include /api2/json.
PVE_URL=https://proxmox.example.internal:8006

# Dedicated read-only API token.
PVE_TOKEN_ID=mcp-reader@pve!chatgpt
PVE_TOKEN_SECRET=change-me

# Prefer true. If Proxmox uses its default self-signed certificate,
# false can be used temporarily until the internal CA is trusted.
PVE_VERIFY_SSL=true

# Loopback-only port used by the OpenAI tunnel client on the Docker host.
MCP_HTTP_PORT=8765
