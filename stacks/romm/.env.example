# RomM stack environment variables for Portainer
# Copy these into Portainer stack environment variables.
# Do not commit real secrets to Git.

ROMM_HTTP_PORT=8080

ROMM_DB_NAME=romm
ROMM_DB_USER=romm-user
ROMM_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=change-me

IGDB_CLIENT_ID=change-me
IGDB_CLIENT_SECRET=change-me

SCREENSCRAPER_USER=change-me
SCREENSCRAPER_PASSWORD=change-me

STEAMGRIDDB_API_KEY=change-me

HASHEOUS_API_ENABLED=true
HLTB_API_ENABLED=true

# Set to true after your Authentik/OIDC config is ready.
OIDC_ENABLED=false
OIDC_PROVIDER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SERVER_APPLICATION_URL=
